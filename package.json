{
  "name": "sd-sales-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "SAPUI5 freestyle SD Sales Cockpit with JSON mock data",
  "scripts": {
    "cap": "cds watch",
    "start": "ui5 serve --open index.html",
    "serve": "ui5 serve"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1.7.8",
    "@sap/cds": "^8.9.0",
    "@sap/cds-dk": "^8.9.6",
    "@ui5/cli": "^4.0.16"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    },
    "server": {
      "cors": true
    }
  }
}
