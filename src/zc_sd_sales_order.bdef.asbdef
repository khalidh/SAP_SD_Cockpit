projection;
strict ( 2 );

define behavior for ZC_SD_SALES_ORDER alias SalesOrder
{
  use create;
  use update;
  use delete;

  use association _Items { create; }
  use association _ProcessSteps { create; }
}

define behavior for ZC_SD_SALES_ORDER_ITEM alias SalesOrderItem
{
  use update;
  use delete;

  use association _SalesOrder;
}

define behavior for ZC_SD_PROCESS_STEP alias ProcessStep
{
  use update;
  use delete;

  use association _SalesOrder;
}
